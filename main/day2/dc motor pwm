
clear;
clc;
close all;

dt = 0.01;
T = 3;
time = 0:dt:T;

%% motor settings

tau = 0.80;          % motor time constant (s)
maxSpeed = 0.40;     % maximum wheel speed (m/s)

%% create arrays

duty = zeros(size(time));
targetSpeed = zeros(size(time));
wheelSpeed = zeros(size(time));

%% set pwm duty cycle

for k = 1:length(time)

    if time(k) < 1
        duty(k) = 0.25;
    elseif time(k) < 2
        duty(k) = 0.75;
    else
        duty(k) = 0.40;
    end

    targetSpeed(k) = duty(k)*maxSpeed;

end

%% simulate motor response

for k = 2:length(time)

    speedError = targetSpeed(k-1) - wheelSpeed(k-1);

    speedChange = (dt/tau)*speedError;

    wheelSpeed(k) = wheelSpeed(k-1) + speedChange;

end

%% plot results

figure('Color','w','Position',[100 100 900 650]);

subplot(2,1,1);

plot(time,wheelSpeed,'b','LineWidth',2);
hold on;
plot(time,targetSpeed,'r--','LineWidth',1.5);

grid on;
xlabel('time (s)');
ylabel('wheel speed (m/s)');
legend('actual speed','requested speed');
title('motor speed response');

subplot(2,1,2);

plot(time,duty*100,'k','LineWidth',2);

grid on;
xlabel('time (s)');
ylabel('duty cycle (%)');
ylim([0 100]);
title('pwm duty cycle');

sgtitle(sprintf('dc motor pwm control (tau = %.2f s)',tau));
